# Pacemate Environment Configuration
# Database Connection (SQLite for local zero-config, or replace with PostgreSQL string like postgresql://user:pass@host:5432/pacemate)
DATABASE_URL="file:./dev.db"

# Server Port
PORT=5000

# Resend Email Notification API Key (Optional: if omitted, email notifications are cleanly logged to system audit)
RESEND_API_KEY="re_123456789_sample_key"
SENDER_EMAIL="Pacemate Run Club <notifications@resend.dev>"
